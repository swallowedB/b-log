# Existing public Supabase client (likes etc.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Prefer secret key; existing SUPABASE_SERVICE_ROLE_KEY also supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random characters and keep only in server settings.
RESUME_CHAT_IDENTITY_SECRET=
RESUME_CHAT_AI_ENABLED=false
# App cap, not Google's quota; lower this to the actual project limit.
RESUME_CHAT_GLOBAL_RPM=3
# Gemini Developer API: no GOOGLE_API_KEY/Vertex fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FREE_PROJECT_ID=
GEMINI_FREE_PROJECT_NUMBER=
# JSON service_account credentials, readonly apikeys.keys.lookup + resourcemanager.projects.get.
# Do not grant billing mutation permissions. Never put credentials in NEXT_PUBLIC_*.
GOOGLE_FREE_TIER_READER_CREDENTIALS=
